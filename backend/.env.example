DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set production on the host; production validates TLS, HTTPS origins and required keys.
APP_ENV=development
ADMIN_TOKEN=replace-with-long-random-token
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated cc_anon UUIDs for the team's browsers, configured BEFORE test walks.
# Include curator here only when its publishing actions are internal tests.
INTERNAL_ANONYMOUS_IDS=
