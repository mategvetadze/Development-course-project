NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest
# Match POSTHOG_HOST on the API (eu or us); rewrites keep the browser on /ingest.
NEXT_PUBLIC_POSTHOG_REGION=eu
# Set production on the host to require HTTPS API and analytics configuration.
APP_ENV=development
